# Solace kernel configuration fragment, merged onto x86_64_defconfig by
# recipes/linux. Everything the boot path needs is built in, so QEMU and
# typical hardware boot without modules.

CONFIG_LOCALVERSION="-solace"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="solace"
# No upstream branding on screen (CLAUDE.md rule 11).
CONFIG_LOGO=n

# Boot: UEFI, GPT, initramfs (zstd), framebuffer console for text login.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# fbdev on top of the DRM driver: the framebuffer console needs it.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Filesystems: btrfs for the system, FAT for the ESP.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Storage and devices: QEMU virtio, plus NVMe/AHCI/USB for real machines.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y

# sol-init: cgroups v2 for service limits.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_PSI=y

# Modules stay possible (NVIDIA, Phase 4) but unsigned for now.
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_SIG=n
# sol-init loads modules itself (no kmod): the kernel decompresses them.
CONFIG_MODULE_DECOMPRESS=y
# zram swap (an installer option), as a module: also exercises module
# loading on every boot of the QEMU image.
CONFIG_ZRAM=m

# BPF, the base for sched_ext (enabled once our toolchain has pahole for
# BTF; see docs/DECISIONS.md "sched_ext deferred").
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# The ESP, mounted at /boot for system transactions (FAT32, vfat names).
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
